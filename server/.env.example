# ---------------------------------------------------------------------------
# GIFTKART — server environment template.
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` (it holds secrets) — it is already listed in .gitignore.
# ---------------------------------------------------------------------------

PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/giftkart

# Secret used to sign JWT auth tokens — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app and this API are reachable
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# --- Payments ---------------------------------------------------------------
# INR orders are paid via UPI (manual QR + UTR) or Razorpay.
# USDT orders are paid on-chain to the wallet address below.

# Razorpay (INR card/UPI/netbanking gateway) — optional, "coming soon" in UI
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PayPal (legacy USD) — optional
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Manual UPI collection (INR) — the QR/payee shown at checkout
UPI_ID=yourname@upi
UPI_PAYEE_NAME=Your Store Name

# Your own USDT wallet address — copy this from Binance/Bybit (or any
# exchange/wallet). Customers send USDT here directly, no gateway involved.
USDT_WALLET_ADDRESS=your_usdt_wallet_address
USDT_NETWORK=TRC20

# --- Email (Brevo / Sendinblue) ---------------------------------------------
EMAIL_FROM=noreply@yourstore.com
EMAIL_FROM_NAME=GIFTKART
BREVO_API_KEY=your_brevo_api_key
CONTACT_INBOX=support@yourstore.com
