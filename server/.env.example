PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ps-giftcard-store?appName=Cluster0
JWT_SECRET=replace_this_with_a_long_random_secret_key

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Razorpay (get these from the Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# PayPal (get these from developer.paypal.com > My Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# NOWPayments - for USDT/crypto payments (get from nowpayments.io dashboard)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# Manual UPI - your own UPI ID, shown to customers as a QR code (no gateway needed)
UPI_ID=yourname@okhdfcbank
UPI_PAYEE_NAME=GIFTKART

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=aapka_email@gmail.com
EMAIL_PASS=16-character-app-password
EMAIL_FROM="GIFTKART <aapka_email@gmail.com>"
CONTACT_INBOX=aapka_email@gmail.com